filters:
  and:
    - file.ext == "md"
    - file.hasTag("articles")
    - file.name != "index"
formulas:
  article: link(file.path, file.name.slice(0, -13))
  published: created.slice(0, 10)
properties:
  formula.article:
    displayName: Article
  formula.published:
    displayName: Published
  tags:
    displayName: Tags
views:
  - type: table
    name: Articles
    order:
      - formula.article
      - formula.published
      - tags
    sort:
      - property: created
        direction: DESC
